# dentalDB-backend/.env.example
# Copy to .env and fill in real values. Every var the backend actually reads
# lives here — if you add a new process.env.X or config.get('X') in code,
# add it here too so this stays the single source of truth (see the
# monorepo remediation doc, §2).

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# DB_DRIVER=postgres in the cloud, DB_DRIVER=sqlite for the Electron desktop
# build (the Electron main process forces this to 'sqlite' itself).
DB_DRIVER=postgres

# ── Database (Postgres / cloud) ─────────────────────────────────────────
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=dentaldb
DB_POOL_MAX=10

# ── Database (SQLite / Electron offline) ────────────────────────────────
SQLITE_DB_PATH=./offline-data.sqlite
SQLITE_AUTO_MIGRATE=true

# ── Domains — REAL LIVE VALUES, confirm with DNS/hosting owner before
# changing (see remediation doc §2: don't infer from branding) ──────────
# The live, currently-hosted API + admin domain:
ROOT_DOMAIN=clinickarobar.com
SITE_DOMAIN=aastal.com
# Extra origins to allow in CORS beyond ROOT_DOMAIN subdomains + custom
# clinic domains (comma-separated), e.g. staging URLs.
EXTRA_CORS_ORIGINS=

# ── Frontend URLs the backend redirects/links back to ──────────────────
# Used for: payment gateway return/cancel URLs (eSewa/Khalti/PayPal),
# invoice "pay" links sent to patients, subscription-renewal reminder
# emails, and WebSocket CORS. dentaldb (admin) runs on 3002 in dev, clinic
# (patient/booking/telehealth app) runs on 3000 in dev.
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3002
BACKEND_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api/v1
BACKEND_PORT=4000
FRONTEND_PORT=3002
APP_PLATFORM=web

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
PATIENT_JWT_SECRET=
COOKIE_SECURE=false
OFFLINE_SESSION_GRACE_DAYS=7

# ── Payments ─────────────────────────────────────────────────────────────
ESEWA_MERCHANT_CODE=
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Email / SMS ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Support/from address — matches the live domain; only change alongside an
# actual email-hosting migration, not preemptively for branding.
SMTP_FROM=noreply@clinickarobar.com
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# ── Telehealth ───────────────────────────────────────────────────────────
DAILY_API_KEY=
TELEHEALTH_PROVIDER=daily

# ── Sync (Electron offline devices) ─────────────────────────────────────
# Set only for dev/CI convenience — production devices get this written to
# sync-config.json automatically on first login (see sync-config.js).
SYNC_REMOTE_BASE_URL=
SYNC_CONFIG_PATH=
SYNC_DEVICE_TOKEN=

# ── ML service (if used) ─────────────────────────────────────────────────
ML_SERVICE_URL=
ML_API_KEY=
# Used to reversibly encrypt the Jwantra integration's webhook signing
# secret (src/integrations/jwantra/utils/secret-crypto.util.ts). Accepts a
# 64-char hex string or any passphrase (hashed to a key either way). Falls
# back to JWT_SECRET if unset — set this explicitly in production.
INTEGRATION_ENCRYPTION_KEY=

# Base URL of Jwantra's API (used only by integrations/jwantra's ask()
# proxy, to fetch AI analysis for the "Jwantra AI" page). Defaults to
# https://api.jwantra.com if unset — override for staging/self-hosted.
JWANTRA_API_URL=https://api.jwantra.com
# If jwantra.com's DNS/domain is down, point this at the known IP instead,
# e.g. https://203.0.113.10 or http://203.0.113.10:8080 (bare http if the
# origin doesn't terminate TLS on that IP). If using https + an IP, also set
# JWANTRA_TLS_SERVERNAME below so the domain's TLS cert still validates.
# JWANTRA_API_URL=https://203.0.113.10
# JWANTRA_TLS_SERVERNAME=api.jwantra.com

# ── Cache ────────────────────────────────────────────────────────────────
CACHE_TTL_MS=60000
CACHE_MAX_ITEMS=500

# ── Uploads (desktop/Electron override; see UPLOADS_DIR fix in main.js) ──
UPLOADS_DIR=
