# electron/.env.example — Desktop shell (dev + build-time vars)

# ── Dev-only overrides ────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=3002
DEV_BACKEND_DIR=
DEV_FRONTEND_DIR=
# Only for dev/CI convenience — see sync-config.js. Leave unset in a real
# packaged build; that reads sync-config.json (or the built-in default,
# https://clinickarobar.com) instead.
SYNC_REMOTE_BASE_URL=

# ── macOS code signing + notarization (GitHub Actions secrets, NOT this
#    file) ──────────────────────────────────────────────────────────────
# electron-builder / notarize.js need these to produce a signed, notarized
# .app/.dmg. Without them, the build still succeeds but ships UNSIGNED —
# see notarize.js's own log line ("Apple credentials not set — skipping
# notarization"). An unsigned/unnotarized app is what triggers macOS
# Gatekeeper's "can't be opened because it is from an unidentified
# developer" / "is damaged and can't be opened" error on a fresh install —
# this is expected without these, not a bug in the app itself:
#
#   CSC_LINK                       (base64 .p12 cert, or path/URL to it)
#   CSC_KEY_PASSWORD                (password for the .p12)
#   APPLE_ID                        (Apple ID email enrolled in the
#                                    Apple Developer Program)
#   APPLE_APP_SPECIFIC_PASSWORD     (generated at appleid.apple.com,
#                                    NOT your Apple ID password)
#   APPLE_TEAM_ID                   (found in developer.apple.com
#                                    membership details)
#
# These require an active $99/yr Apple Developer Program membership —
# there's no free way to get a build that opens with zero user-side steps
# on a fresh Mac. See electron/README (mac Gatekeeper note) for the
# workaround end-users can use on an unsigned build in the meantime.
